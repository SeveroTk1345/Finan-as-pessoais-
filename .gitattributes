# Scripts rodam dentro de containers Linux: sempre LF, mesmo clonando no Windows
# (com CRLF o banco nem inicializa: "/bin/sh^M: bad interpreter").
*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
*.yml       text eol=lf
*.py        text eol=lf
# PowerShell do Windows: CRLF.
*.ps1       text eol=crlf
