# Copie para .env (raiz e/ou deploy/) e troque TODOS os valores. Nunca coloque o .env no Git.
# Gere senhas com:  openssl rand -base64 24

# development | test | production
FIN_ENVIRONMENT=development

# Endereço do FastAPI usado pelo "next dev" para encaminhar /api
FIN_DEV_API_ORIGIN=http://127.0.0.1:8000

# --- Banco (deploy/docker-compose.yml) ---
FIN_DB_ADMIN_PASSWORD=troque-esta-senha-admin
FIN_DB_APP_PASSWORD=troque-esta-senha-app

# URLs usadas pelo backend fora do Docker (desenvolvimento com docker-compose.dev.yml)
# A API usa SEMPRE o papel fin_app. O admin só para migrações e backups.
FIN_DATABASE_URL=postgresql+psycopg://fin_app:troque-esta-senha-app@127.0.0.1:5432/financas
FIN_DATABASE_ADMIN_URL=postgresql+psycopg://fin_admin:troque-esta-senha-admin@127.0.0.1:5432/financas

# --- Backup ---
FIN_BACKUP_KEEP=14
FIN_BACKUP_INTERVAL_SECONDS=86400
# Pasta no servidor onde as cópias ficam (fora do volume do banco)
FIN_BACKUP_HOST_DIR=./backups
